                        type="button"
                        onClick={() => removeInterest(interest)}
                        className="inline-flex items-center gap-1 rounded-full bg-[#00FF66]/10 px-3 py-1.5 text-[9px] font-bold text-[#00FF66]"
                      >
                        {interest}
                        <X className="w-3 h-3" />
                      </button>
                    ))}
                  </div>
                )}
              </div>

              {/* ACHIEVEMENTS */}
              <div>
                <label className="text-[10px] font-black uppercase text-gray-400 block mb-3">
                  Personal Achievements
                </label>

                <div className="flex gap-2">
                  <input
                    value={newAchievement}
                    onChange={(event) =>
                      setNewAchievement(event.target.value)
                    }
                    onKeyDown={(event) => {
                      if (event.key === 'Enter') {
                        event.preventDefault();
                        addAchievement();
                      }
                    }}
                    placeholder="e.g. Represented college at State Level"
                    className="min-w-0 flex-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs text-white outline-none placeholder:text-gray-600 focus:border-amber-400/40"
                  />

                  <button
                    type="button"
                    onClick={addAchievement}
                    className="rounded-xl border border-amber-400/30 bg-amber-400/10 px-4 text-amber-300 transition hover:bg-amber-400/20"
                  >
                    <Plus className="w-4 h-4" />
                  </button>
                </div>

                {editAchievements.length > 0 && (
                  <div className="space-y-2 mt-3">
                    {editAchievements.map((achievement) => (
                      <div
                        key={achievement}
                        className="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 px-3 py-2"
                      >
                        <span className="text-xs text-gray-300">
                          {achievement}
                        </span>

                        <button
                          type="button"
                          onClick={() =>
                            removeAchievement(achievement)
                          }
                          className="shrink-0 text-gray-600 hover:text-red-400"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              {profileSaveError && (
                <div className="rounded-xl border border-red-400/20 bg-red-400/5 px-4 py-3 text-xs text-red-300">
                  {profileSaveError}
                </div>
              )}

              <div className="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 border-t border-white/10 pt-5">
                <button
                  type="button"
                  onClick={() => setIsEditingProfile(false)}
                  className="rounded-full border border-white/10 bg-white/5 px-6 py-3 text-[10px] font-black uppercase text-gray-300 transition hover:bg-white/10"
                >
                  Cancel
                </button>

                <button
                  type="button"
                  onClick={handleSaveProfile}
                  disabled={savingProfile}
                  className="rounded-full bg-[#00FF66] px-7 py-3 text-[10px] font-black uppercase text-black transition hover:bg-[#00FF66]/90 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {savingProfile ? 'Saving...' : 'Save Changes'}
                </button>
              </div>

            </div>
          </motion.div>
        </div>
      )}

      {/* GROUND CREW ACTIVATION MODAL */}
      {showCrewActivation && profile && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 p-4 backdrop-blur-md">
          <motion.div
            initial={{ opacity: 0, scale: 0.96, y: 12 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            className="w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-3xl border border-[#00FF66]/20 bg-[#0a0a0a] p-6 shadow-[0_25px_100px_rgba(0,0,0,0.6)]"
          >
            <div className="flex items-start justify-between gap-4">
              <div>
                <div className="flex items-center gap-2">
                  <ShieldCheck className="w-5 h-5 text-[#00FF66]" />
                  <h2 className="text-xl font-black italic uppercase text-white">
                    ACTIVATE GROUND CREW
                  </h2>
                </div>

                <p className="mt-2 text-sm font-semibold uppercase tracking-wide text-gray-300">
                  Tell organizers what you are qualified to do.
                </p>
              </div>

              <button
                type="button"
                onClick={() => {
                  if (!crewActivationLoading) {
                    setShowCrewActivation(false);
                    setCrewActivationError('');
                  }
                }}
                className="rounded-full border border-white/10 bg-white/5 p-2 text-gray-400 transition hover:border-white/20 hover:text-white"
                aria-label="Close Ground Crew activation form"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            {/* EXISTING ACCOUNT INFORMATION */}
            <div className="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
              <p className="text-[9px] font-black uppercase tracking-wider text-gray-600">
                Your Sportora Profile
              </p>

              <div className="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <span className="text-xs font-black uppercase tracking-wide text-gray-300">
                    Name
                  </span>
                  <p className="mt-1 text-sm font-bold text-white">
                    {profile.fullName || '—'}
                  </p>
                </div>

                <div>
                  <span className="text-xs font-black uppercase tracking-wide text-gray-300">
                    Email
                  </span>
                  <p className="mt-1 break-all text-sm font-bold text-white">
                    {profile.email || '—'}
                  </p>
                </div>

                <div>
                  <span className="text-xs font-black uppercase tracking-wide text-gray-300">
                    Location
                  </span>
                  <p className="mt-1 text-sm font-bold text-white">
                    {profile.city && profile.state
                      ? `${profile.city}, ${profile.state}`
                      : 'Complete your profile location first'}
                  </p>
                </div>

                <div>
                  <span className="text-xs font-black uppercase tracking-wide text-gray-300">
                    Account
                  </span>
                  <p className="mt-1 text-sm font-bold text-[#00FF66]">
                    {profile.role}
                  </p>
                </div>
              </div>
            </div>

            {/* PRIMARY ROLE */}
            <div className="mt-5">
              <label
                htmlFor="crew-activation-role"
                className="mb-2 block text-xs font-black uppercase tracking-wide text-gray-300"
              >
                Primary Crew Role
              </label>

              <select
                id="crew-activation-role"
                value={crewActivationRole}
                onChange={(event) =>
                  setCrewActivationRole(event.target.value)
                }
                className="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm font-bold text-white outline-none transition focus:border-[#00FF66]/40"
              >
                <option value="" className="bg-[#0a0a0a]">
                  Select your primary role
                </option>
                <option value="REFEREE" className="bg-[#0a0a0a]">
                  Referee
                </option>
                <option value="UMPIRE" className="bg-[#0a0a0a]">
                  Umpire
                </option>
                <option value="SCOREKEEPER" className="bg-[#0a0a0a]">
                  Scorekeeper
                </option>
                <option value="VOLUNTEER" className="bg-[#0a0a0a]">
                  Volunteer
                </option>
              </select>
            </div>

            {/* SPORTS */}
            <div className="mt-5">
              <span className="mb-2 block text-xs font-black uppercase tracking-wide text-gray-300">
                Sports Expertise
              </span>

              <div className="flex flex-wrap gap-2">
                {[
                  'Football',
                  'Cricket',
                  'Badminton',
                  'Table Tennis',
                  'Basketball',
                  'Volleyball',
                  'Hockey',
                  'Tennis',
                  'Kabaddi',
                ].map((sport) => {
                  const selected = crewActivationSports.includes(sport);

                  return (
                    <button
                      key={sport}
                      type="button"
                      onClick={() =>
                        setCrewActivationSports((current) =>
                          selected
                            ? current.filter((item) => item !== sport)
                            : [...current, sport],
                        )
                      }
                      className={`rounded-full border px-3 py-2 text-[9px] font-black uppercase transition ${
                        selected
                          ? 'border-[#00FF66]/50 bg-[#00FF66]/10 text-[#00FF66]'
                          : 'border-white/10 bg-white/5 text-gray-500 hover:border-white/20 hover:text-gray-300'
                      }`}
                    >
                      {sport}
                    </button>
                  );
                })}
              </div>
            </div>

            {/* SKILLS */}
            <div className="mt-5">
              <label
                htmlFor="crew-activation-skills"
                className="mb-2 block text-xs font-black uppercase tracking-wide text-gray-300"
              >
                Key Skills / Expertise
              </label>

              <input
                id="crew-activation-skills"
                value={crewActivationSkills}
                onChange={(event) =>
                  setCrewActivationSkills(event.target.value)
                }
                placeholder="Match officiating, rule enforcement, timekeeping, scoring"
                className="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white outline-none transition placeholder:text-gray-700 focus:border-[#00FF66]/40"
              />

              <p className="mt-2 text-[9px] text-gray-600">
                Separate multiple skills with commas.
              </p>
            </div>

            {/* EXPERIENCE */}
            <div className="mt-5">
              <label
                htmlFor="crew-activation-experience"
                className="mb-2 block text-xs font-black uppercase tracking-wide text-gray-300"
              >
                Experience (Years)
              </label>

              <input
                id="crew-activation-experience"
                type="number"
                min="0"
                max="60"
                value={crewActivationExperience}
                onChange={(event) =>
                  setCrewActivationExperience(event.target.value)
                }
                placeholder="e.g. 3"
                className="w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white outline-none transition placeholder:text-gray-700 focus:border-[#00FF66]/40"
              />
            </div>

            {crewActivationError && (
              <div className="mt-5 rounded-xl border border-red-400/20 bg-red-400/5 px-4 py-3 text-xs text-red-300">
                {crewActivationError}
              </div>
            )}

            <div className="mt-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-3 border-t border-white/10 pt-5">
              <button
                type="button"
                onClick={() => {
                  if (!crewActivationLoading) {
                    setShowCrewActivation(false);
                    setCrewActivationError('');
                  }
                }}
                disabled={crewActivationLoading}
                className="rounded-full border border-white/10 bg-white/5 px-6 py-3 text-[10px] font-black uppercase text-gray-300 transition hover:bg-white/10 disabled:opacity-50"
              >
                Cancel
              </button>

              <button
                type="button"
                onClick={handleCrewActivation}
                disabled={crewActivationLoading}
                className="rounded-full bg-[#00FF66] px-7 py-3 text-[10px] font-black uppercase text-black transition hover:bg-[#00FF66]/90 disabled:cursor-not-allowed disabled:opacity-60"
              >
                {crewActivationLoading
                  ? 'Activating...'
                  : 'Activate Ground Crew'}
              </button>
            </div>
          </motion.div>
        </div>
      )}

      {/* CREW COMPLETION MODAL */}
      {completionAssignment && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 p-4 backdrop-blur-md">
          <motion.div
            initial={{ opacity: 0, scale: 0.96, y: 12 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            className="w-full max-w-lg rounded-3xl border border-cyan-400/20 bg-[#0a0a0a] p-6 shadow-[0_25px_100px_rgba(0,0,0,0.6)]"
          >
            <div className="flex items-start justify-between gap-4">
              <div>
                <div className="flex items-center gap-2">
                  <ShieldCheck className="w-5 h-5 text-cyan-400" />
                  <h2 className="text-xl font-black italic uppercase text-white">
                    SUBMIT COMPLETION
                  </h2>
                </div>

                <p className="mt-2 text-sm font-semibold uppercase tracking-wide text-gray-300">
                  Confirm that your assigned event work has been completed.
                </p>
              </div>

              <button
                type="button"
                onClick={() => {
                  if (!submittingCompletion) {
                    setCompletionAssignment(null);
                    setCompletionNote('');
                    setCompletionProofFiles([]);
                    setCompletionProofUrls([]);
                  }
                }}
                className="rounded-full border border-white/10 bg-white/5 p-2 text-gray-400 transition hover:border-white/20 hover:text-white"
                aria-label="Close completion form"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <div className="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
              <p className="text-xs font-black uppercase tracking-wide text-gray-300">
                Tournament
              </p>

              <p className="mt-1 text-lg font-black uppercase tracking-tight text-white">
                {typeof completionAssignment.tournamentId === 'object'
                  ? completionAssignment.tournamentId.title
                  : 'Tournament Assignment'}
              </p>
            </div>

            <div className="mt-5">
              <label
                htmlFor="crew-completion-note"
                className="mb-2 block text-xs font-black uppercase tracking-wide text-gray-300"
              >
                Completion Note
              </label>

              <textarea
                id="crew-completion-note"
                value={completionNote}
                onChange={(event) =>
                  setCompletionNote(event.target.value)
                }
                rows={4}
                placeholder="Describe the work completed during this event..."
                className="w-full resize-none rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white outline-none transition placeholder:text-gray-700 focus:border-cyan-400/40"
              />
            </div>

            <div className="mt-5">
              <label className="mb-2 block text-xs font-black uppercase tracking-wide text-gray-300">
                Completion Evidence <span className="text-cyan-400">*</span>
              </label>

              <label
                htmlFor="crew-completion-proof"
                className="flex cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed border-cyan-400/25 bg-cyan-400/[0.03] px-4 py-5 text-center transition hover:border-cyan-400/50 hover:bg-cyan-400/[0.06]"
              >
                <Plus className="h-4 w-4 text-cyan-400" />
                <span className="text-xs font-black uppercase tracking-wide text-cyan-200">
                  Add Proof / Evidence
                </span>

                <input
                  id="crew-completion-proof"
                  type="file"
                  multiple
                  accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/webm,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"
                  className="hidden"
                  onChange={(event) => {
                    const selected = Array.from(event.target.files || []);

                    const allowed = new Set([
                      'image/jpeg',
                      'image/png',
                      'image/webp',
                      'video/mp4',
                      'video/quicktime',
                      'video/webm',
                      'application/pdf',
                      'application/msword',
                      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                      'application/vnd.ms-excel',
                      'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                      'text/csv',
                    ]);

                    const invalid = selected.find(
                      (file) =>
                        !allowed.has(file.type) ||
                        file.size <= 0 ||
                        file.size > 50 * 1024 * 1024,
                    );

                    if (invalid) {
                      setCrewAssignmentsError(
                        `${invalid.name} is not supported or exceeds the 50 MB file limit.`,
                      );
                      event.target.value = '';
                      return;
                    }

                    if (completionProofFiles.length + selected.length > 5) {
                      setCrewAssignmentsError(
                        'You can attach a maximum of 5 proof files.',
                      );
                      event.target.value = '';
                      return;
                    }

                    setCrewAssignmentsError('');
                    setCompletionProofFiles((current) => [
                      ...current,
                      ...selected,
                    ]);
                    setCompletionProofUrls([]);
                    event.target.value = '';
                  }}
                />
              </label>

              {completionProofFiles.length > 0 && (
                <div className="mt-3 space-y-2">
                  {completionProofFiles.map((file, index) => (
                    <div
                      key={`${file.name}-${file.lastModified}-${index}`}
                      className="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2"
                    >
                      <div className="min-w-0">
                        <p className="truncate text-xs font-bold text-white">
                          {file.name}
                        </p>
                        <p className="mt-0.5 text-[10px] uppercase text-gray-400">
                          {(file.size / (1024 * 1024)).toFixed(2)} MB
                        </p>
                      </div>

                      <button
                        type="button"
                        onClick={() => {
                          setCompletionProofFiles((current) =>
                            current.filter(
                              (_, fileIndex) => fileIndex !== index,
                            ),
                          );
                          setCompletionProofUrls([]);
                        }}
                        className="shrink-0 rounded-full border border-white/10 p-1.5 text-gray-500 transition hover:border-red-400/30 hover:text-red-300"
                        aria-label={`Remove ${file.name}`}
                      >
                        <X className="h-3.5 w-3.5" />
                      </button>
                    </div>
                  ))}
                </div>
              )}

              {completionProofFiles.length === 0 &&
                completionProofUrls.length === 0 && (
                  <p className="mt-2 text-xs font-medium text-amber-300">
                    At least one proof attachment is required. You can attach
                    photos, videos, PDFs, Word documents, Excel sheets, or CSV
                    files.
                  </p>
                )}

              {completionProofUrls.length > 0 &&
                completionProofFiles.length === 0 && (
                  <p className="mt-2 text-xs font-medium text-emerald-300">
                    Existing completion evidence is already attached to this
                    submission.
                  </p>
                )}
            </div>

            {crewAssignmentsError && (
              <div className="mt-5 rounded-xl border border-red-400/20 bg-red-400/5 px-4 py-3">
                <p className="text-xs font-bold uppercase tracking-wide text-red-300">
                  Submission Error
                </p>
                <p className="mt-1 text-sm font-medium leading-relaxed text-red-200">
                  {crewAssignmentsError}
                </p>
              </div>
            )}

            <div className="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
              <button
                type="button"
                disabled={submittingCompletion}
                onClick={() => {
                  setCompletionAssignment(null);
                  setCompletionNote('');
                  setCompletionProofFiles([]);
                    setCompletionProofUrls([]);
                }}
                className="rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-xs font-black uppercase tracking-wide text-gray-300 transition hover:bg-white/10 hover:text-white disabled:opacity-50"
              >
                Cancel
              </button>

              <button
                type="button"
                disabled={
                  submittingCompletion ||
                  uploadingCompletionProof ||
                  (completionProofFiles.length === 0 &&
                    completionProofUrls.length === 0)
                }
                onClick={handleSubmitCrewCompletion}
                className="rounded-xl border border-[#00FF66]/30 bg-[#00FF66]/10 px-5 py-3 text-[9px] font-black uppercase tracking-wider text-[#00FF66] transition hover:border-[#00FF66]/60 hover:bg-[#00FF66]/20 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {uploadingCompletionProof
                  ? 'UPLOADING PROOF...'
                  : submittingCompletion
                    ? 'SUBMITTING...'
                    : 'SUBMIT COMPLETION'}
              </button>
            </div>
          </motion.div>
        </div>
      )}

      </div>
    </main>
  );

}


export default function ProfilePage() {
  return (
    <Suspense fallback={null}>
      <ProfilePageContent />
    </Suspense>
  );
}
