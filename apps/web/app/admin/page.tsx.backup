'use client';

import { useState, useEffect } from 'react';

export default function AdminDashboardPage() {
  const [analytics, setAnalytics] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // Mock or Live Fetch
    setTimeout(() => {
      setAnalytics({
        summary: {
          totalUsers: 1420,
          totalTournaments: 84,
          totalBookings: 310,
          totalRevenue: '₹2,45,000',
          pendingVerifications: 5
        },
        charts: {
          sportsDistribution: [
            { sport: 'Football', count: 35 },
            { sport: 'Badminton', count: 28 },
            { sport: 'Cricket', count: 21 }
          ]
        }
      });
      setLoading(false);
    }, 500);
  }, []);

  if (loading) {
    return <div className="p-10 text-white bg-slate-900 min-h-screen">Loading Admin Portal...</div>;
  }

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 p-8">
      <div className="max-w-7xl mx-auto space-y-8">
        
        {/* Header */}
        <div className="flex justify-between items-center border-b border-slate-800 pb-5">
          <div>
            <h1 className="text-3xl font-bold text-sky-400">Sportora Platform Control Center</h1>
            <p className="text-slate-400 text-sm">System Analytics, Organizer Verifications & Reports</p>
          </div>
          <a 
            href="/api/admin/reports?type=bookings" 
            className="bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold px-4 py-2 rounded-lg transition"
          >
            📥 Export CSV Report
          </a>
        </div>

        {/* Summary Metrics Cards */}
        <div className="grid grid-cols-1 md:grid-cols-5 gap-4">
          <div className="bg-slate-900 p-5 rounded-xl border border-slate-800">
            <span className="text-slate-400 text-xs uppercase font-bold">Total Users</span>
            <p className="text-2xl font-bold text-white mt-1">{analytics?.summary.totalUsers}</p>
          </div>
          <div className="bg-slate-900 p-5 rounded-xl border border-slate-800">
            <span className="text-slate-400 text-xs uppercase font-bold">Tournaments</span>
            <p className="text-2xl font-bold text-sky-400 mt-1">{analytics?.summary.totalTournaments}</p>
          </div>
          <div className="bg-slate-900 p-5 rounded-xl border border-slate-800">
            <span className="text-slate-400 text-xs uppercase font-bold">Bookings</span>
            <p className="text-2xl font-bold text-emerald-400 mt-1">{analytics?.summary.totalBookings}</p>
          </div>
          <div className="bg-slate-900 p-5 rounded-xl border border-slate-800">
            <span className="text-slate-400 text-xs uppercase font-bold">Total Revenue</span>
            <p className="text-2xl font-bold text-amber-400 mt-1">{analytics?.summary.totalRevenue}</p>
          </div>
          <div className="bg-slate-900 p-5 rounded-xl border border-rose-900/50">
            <span className="text-rose-400 text-xs uppercase font-bold">Pending Review</span>
            <p className="text-2xl font-bold text-rose-400 mt-1">{analytics?.summary.pendingVerifications}</p>
          </div>
        </div>

        {/* Sports Breakdown Table & Verification Quick Panel */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          {/* Sports Breakdown */}
          <div className="bg-slate-900 p-6 rounded-xl border border-slate-800">
            <h2 className="text-lg font-bold text-slate-200 mb-4">🏆 Tournaments by Sport</h2>
            <div className="space-y-3">
              {analytics?.charts.sportsDistribution.map((item: any) => (
                <div key={item.sport} className="flex justify-between items-center bg-slate-950 p-3 rounded-lg">
                  <span className="font-semibold text-slate-300">{item.sport}</span>
                  <span className="bg-sky-950 text-sky-400 font-bold text-xs px-3 py-1 rounded-full">{item.count} Active</span>
                </div>
              ))}
            </div>
          </div>

          {/* Organizer Verification Panel Link */}
          <div className="bg-slate-900 p-6 rounded-xl border border-slate-800 flex flex-col justify-between">
            <div>
              <h2 className="text-lg font-bold text-slate-200 mb-2">🛡️ Organizer Verification Panel</h2>
              <p className="text-slate-400 text-sm">
                Review submitted GST, PAN, and identity documents to grant official Organizer Badges on Sportora V2.
              </p>
            </div>
            <a 
              href="/api/verification/admin/review" 
              className="mt-6 inline-block text-center bg-sky-600 hover:bg-sky-500 text-white font-semibold py-2.5 rounded-lg transition"
            >
              Manage Pending Verification Requests
            </a>
          </div>

        </div>

      </div>
    </div>
  );
}
