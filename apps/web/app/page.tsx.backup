'use client';

import { useState } from 'react';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import TournamentsGrid from '../components/TournamentsGrid';
import RoleDashboard from '../components/RoleDashboard';
import SponsorsTicker from '../components/SponsorsTicker';

export default function Home() {
  const [searchQuery, setSearchQuery] = useState('');

  return (
    <main className="min-h-screen bg-[#080B10] text-white selection:bg-[#00FF66] selection:text-black">
      <Navbar />
      <Hero query={searchQuery} setQuery={setSearchQuery} />
      <SponsorsTicker />
      <TournamentsGrid query={searchQuery} />
      <RoleDashboard />
    </main>
  );
}
