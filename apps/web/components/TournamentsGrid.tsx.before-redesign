interface GridProps {
  query?: string;
}

export default function TournamentsGrid({ query = '' }: GridProps) {
  const [selectedTournament, setSelectedTournament] = useState<typeof MOCK_TOURNAMENTS[0] | null>(null);
  
  // Registration & Payment States
  const [step, setStep] = useState<'details' | 'form' | 'payment' | 'success'>('details');
  const [formData, setFormData] = useState({
    playerName: '',
    phone: '',
    teamName: '',
    paymentMethod: 'upi'
  });
  const [isProcessing, setIsProcessing] = useState(false);

  const filtered = MOCK_TOURNAMENTS.filter((t) => {
    const q = query.toLowerCase().trim();
    if (!q) return true;
    return (
      t.title.toLowerCase().includes(q) ||
      t.sport.toLowerCase().includes(q) ||
      t.location.toLowerCase().includes(q)
    );
  });

  const handleClose = () => {
    setSelectedTournament(null);
    setStep('details');
    setFormData({ playerName: '', phone: '', teamName: '', paymentMethod: 'upi' });
    setIsProcessing(false);
  };

  const handlePaymentSubmit = () => {
    setIsProcessing(true);
    setTimeout(() => {
      setIsProcessing(false);
      setStep('success');
    }, 2000);
  };

  return (
    <section id="tournaments" className="py-20 px-6 max-w-7xl mx-auto relative z-10">
      
      {/* Header */}
      <div className="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <div className="inline-flex items-center gap-2 text-xs font-bold text-[#00FF66] tracking-widest uppercase mb-2">
            <motion.div
              animate={{ rotate: 360 }}
              transition={{ repeat: Infinity, duration: 4, ease: "linear" }}
              className="text-base"
            >
              ⚽
            </motion.div>
            <span>AI-VERIFIED ARENA EVENTS</span>
          </div>
          <h2 className="text-4xl md:text-5xl font-black text-white tracking-tight uppercase italic">
            {query ? `RESULTS FOR "${query.toUpperCase()}"` : 'FEATURED TOURNAMENTS'}
          </h2>
        </div>
        <p className="text-gray-300 text-sm max-w-md">
          Click on any tournament card to view complete schedule, rules, and register your team instantly.
        </p>
      </div>

      {/* Grid Cards */}
      {filtered.length > 0 ? (
        <div className="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
          {filtered.map((item) => (
            <motion.div
              key={item.id}
              whileHover={{ y: -8 }}
              onClick={() => {
                setSelectedTournament(item);
                setStep('details');
              }}
              className="clean-glass rounded-[32px] overflow-hidden group border border-white/10 hover:border-[#00FF66] hover:shadow-[0_0_40px_rgba(0,255,102,0.2)] transition-all flex flex-col justify-between cursor-pointer"
            >
              <div className="relative h-64 overflow-hidden bg-[#080B10]">
                <img
                  src={item.imgUrl}
                  alt={item.title}
                  className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 filter contrast-110"
                />

                <video
                  autoPlay
                  loop
                  muted
                  playsInline
                  className="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-60 mix-blend-screen"
                >
                  <source src={item.videoUrl} type="video/mp4" />
                </video>

                <div className="absolute inset-0 bg-gradient-to-t from-[#080B10] via-black/20 to-black/40 pointer-events-none" />
                
                <div className="absolute top-4 left-4 bg-black/70 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/20 flex items-center gap-2 text-xs font-bold text-white z-10 shadow-lg">
                  <span className="text-sm">{item.icon}</span>
                  <span className="uppercase text-[#00FF66]">{item.sport}</span>
                </div>

                <div className="absolute top-4 right-4 bg-[#00FF66] text-black font-extrabold text-[10px] px-3 py-1 rounded-full uppercase shadow-lg z-10">
                  {item.status}
                </div>

                <div className="absolute bottom-3 right-4 bg-black/80 backdrop-blur-md px-3 py-1 rounded-full border border-[#00FF66]/40 flex items-center gap-1.5 text-xs text-[#00FF66] font-bold shadow-lg z-10">
                  <ShieldCheck className="w-4 h-4" />
                  <span>{item.riskScore}% VERIFIED</span>
                </div>
              </div>

              <div className="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <h3 className="text-xl font-bold text-white mb-3 group-hover:text-[#00FF66] transition-colors leading-snug">
                    {item.title}
                  </h3>
                  
                  <div className="space-y-2 text-xs text-gray-300 mb-6">
                    <div className="flex items-center gap-2">
                      <MapPin className="w-4 h-4 text-gray-400 shrink-0" />
                      <span className="truncate">{item.location}</span>
                    </div>
                    <div className="flex items-center gap-2">
                      <Calendar className="w-4 h-4 text-gray-400 shrink-0" />
                      <span>{item.date}</span>
                    </div>
                  </div>
                </div>

                <div className="pt-4 border-t border-white/10 flex items-center justify-between">
                  <div>
                    <div className="text-[10px] text-gray-400 uppercase font-bold">ENTRY FEE</div>
                    <div className="text-lg font-black text-[#00FF66]">{item.entryFee}</div>
                  </div>

                  <button className="bg-white/10 group-hover:bg-[#00FF66] group-hover:text-black text-white font-bold text-xs px-5 py-2.5 rounded-full transition-all flex items-center gap-1">
                    REGISTER NOW <ArrowUpRight className="w-4 h-4" />
                  </button>
                </div>

              </div>
            </motion.div>
          ))}
        </div>
      ) : (
        <div className="text-center py-16 clean-glass rounded-3xl border border-white/10">
          <p className="text-gray-300 text-sm font-bold uppercase tracking-wider">
            No tournaments found matching "{query}".
          </p>
        </div>
      )}

      {/* REGISTRATION & PAYMENT MODAL */}
      <AnimatePresence>
        {selectedTournament && (
          <div className="fixed inset-0 z-[999999] flex items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-md overflow-y-auto">
            <motion.div
              initial={{ scale: 0.9, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.9, opacity: 0 }}
              className="bg-[#0D111A] text-white border border-[#00FF66]/30 rounded-[36px] max-w-2xl w-full p-6 sm:p-10 relative overflow-hidden shadow-[0_0_80px_rgba(0,255,102,0.2)] my-8"
            >
              {/* Close Button */}
              <button
                onClick={handleClose}
                className="absolute top-6 right-6 bg-white/10 hover:bg-white/20 p-2.5 rounded-full transition-all text-gray-300 hover:text-white z-20"
              >
                <X className="w-5 h-5" />
              </button>

              {/* STEP 1: DETAILS VIEW */}
              {step === 'details' && (
                <div className="space-y-6 relative z-10">
                  <div className="flex items-center gap-3">
                    <span className="text-2xl">{selectedTournament.icon}</span>
                    <span className="bg-[#00FF66]/10 border border-[#00FF66]/40 text-[#00FF66] text-xs font-black px-3 py-1 rounded-full uppercase">
                      {selectedTournament.sport} • {selectedTournament.status}
                    </span>
                  </div>

                  <div>
                    <h2 className="text-2xl sm:text-3xl font-black italic tracking-tight text-white uppercase">
