                    <ul className="space-y-1 text-xs text-gray-300">
                      {selectedTournament.rules.map((rule, idx) => (
                        <li key={idx} className="flex items-center gap-2">
                          <CheckCircle className="w-3.5 h-3.5 text-[#00FF66] shrink-0" />
                          <span>{rule}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div className="pt-4 border-t border-white/10 flex items-center justify-between">
                    <div>
                      <div className="text-[10px] text-gray-400 uppercase">ENTRY FEE</div>
                      <div className="text-2xl font-black text-[#00FF66]">{selectedTournament.entryFee}</div>
                    </div>

                    <button 
                      onClick={() => setStep('form')}
                      className="bg-[#00FF66] hover:bg-emerald-300 text-black font-extrabold text-xs uppercase px-8 py-3.5 rounded-full transition-all flex items-center gap-2"
                    >
                      PROCEED TO REGISTER <ArrowRight className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              )}

              {/* STEP 2: PLAYER / TEAM INFORMATION FORM */}
              {step === 'form' && (
                <div className="space-y-6 relative z-10">
                  <div className="flex items-center justify-between border-b border-white/10 pb-4">
                    <h3 className="text-xl font-black text-white italic uppercase flex items-center gap-2">
                      <User className="w-5 h-5 text-[#00FF66]" /> REGISTRATION FORM
                    </h3>
                    <span className="text-xs font-mono text-[#00FF66]">STEP 1 OF 2</span>
                  </div>

                  <div className="space-y-4">
                    <div>
                      <label className="block text-xs font-mono font-bold text-gray-300 uppercase mb-1">
                        Captain / Player Name *
                      </label>
                      <input 
                        type="text" 
                        placeholder="Enter full name"
                        value={formData.playerName}
                        onChange={(e) => setFormData({ ...formData, playerName: e.target.value })}
                        className="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:border-[#00FF66] outline-none"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-mono font-bold text-gray-300 uppercase mb-1">
                        Phone Number (For WhatsApp Updates) *
                      </label>
                      <input 
                        type="tel" 
                        placeholder="+91 98765 43210"
