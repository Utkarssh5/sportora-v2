                        onChange={(e) => setFormData({ ...formData, phone: e.target.value })}
                        className="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:border-[#00FF66] outline-none"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-mono font-bold text-gray-300 uppercase mb-1">
                        Team Name (Optional for Singles)
                      </label>
                      <input 
                        type="text" 
                        placeholder="e.g. Gurgaon Strikers"
                        value={formData.teamName}
                        onChange={(e) => setFormData({ ...formData, teamName: e.target.value })}
                        className="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:border-[#00FF66] outline-none"
                      />
                    </div>
                  </div>

                  <div className="pt-4 border-t border-white/10 flex items-center justify-between">
                    <button 
                      onClick={() => setStep('details')}
                      className="text-xs font-bold text-gray-400 hover:text-white uppercase"
                    >
                      Back
                    </button>

                    <button 
                      disabled={!formData.playerName || !formData.phone}
                      onClick={() => setStep('payment')}
                      className="bg-[#00FF66] disabled:opacity-40 hover:bg-emerald-300 text-black font-extrabold text-xs uppercase px-8 py-3.5 rounded-full transition-all flex items-center gap-2"
                    >
                      CONTINUE TO PAYMENT <CreditCard className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              )}

              {/* STEP 3: PAYMENT GATEWAY SIMULATION */}
              {step === 'payment' && (
                <div className="space-y-6 relative z-10">
                  <div className="flex items-center justify-between border-b border-white/10 pb-4">
                    <h3 className="text-xl font-black text-white italic uppercase flex items-center gap-2">
                      <CreditCard className="w-5 h-5 text-[#00FF66]" /> PAYMENT GATEWAY
                    </h3>
                    <span className="text-xs font-mono text-[#00FF66]">STEP 2 OF 2</span>
                  </div>

                  <div className="bg-white/5 p-4 rounded-2xl border border-white/10 flex items-center justify-between">
                    <div>
                      <div className="text-[10px] text-gray-400 uppercase font-mono">TOTAL AMOUNT PAYABLE</div>
                      <div className="text-2xl font-black text-[#00FF66]">{selectedTournament.entryFee}</div>
                    </div>
                    <div className="text-right text-xs text-gray-300">
                      <div className="font-bold text-white">{formData.playerName}</div>
                      <div className="text-gray-400">{formData.phone}</div>
                    </div>
                  </div>

                  <div className="space-y-3">
                    <label className="block text-xs font-mono font-bold text-gray-300 uppercase">
                      SELECT PAYMENT METHOD
                    </label>

                    <div className="grid grid-cols-2 gap-3">
                      <button 
                        onClick={() => setFormData({ ...formData, paymentMethod: 'upi' })}
                        className={`p-4 rounded-2xl border flex items-center gap-3 transition-all ${formData.paymentMethod === 'upi' ? 'border-[#00FF66] bg-[#00FF66]/10 text-white' : 'border-white/10 bg-white/5 text-gray-400'}`}
                      >
                        <QrCode className="w-5 h-5 text-[#00FF66]" />
                        <span className="text-xs font-bold uppercase">UPI / QR SCAN</span>
                      </button>

                      <button 
                        onClick={() => setFormData({ ...formData, paymentMethod: 'card' })}
                        className={`p-4 rounded-2xl border flex items-center gap-3 transition-all ${formData.paymentMethod === 'card' ? 'border-[#00FF66] bg-[#00FF66]/10 text-white' : 'border-white/10 bg-white/5 text-gray-400'}`}
                      >
                        <CreditCard className="w-5 h-5 text-[#00FF66]" />
                        <span className="text-xs font-bold uppercase">CARD / NETBANKING</span>
                      </button>
                    </div>
                  </div>

                  <div className="pt-4 border-t border-white/10 flex items-center justify-between">
                    <button 
                      onClick={() => setStep('form')}
                      className="text-xs font-bold text-gray-400 hover:text-white uppercase"
                    >
                      Back
                    </button>

                    <button 
                      onClick={handlePaymentSubmit}
                      disabled={isProcessing}
                      className="bg-[#00FF66] hover:bg-emerald-300 text-black font-extrabold text-xs uppercase px-8 py-3.5 rounded-full transition-all flex items-center gap-2 shadow-lg shadow-[#00FF66]/20"
                    >
                      {isProcessing ? (
                        <span>PROCESSING PAYMENT...</span>
                      ) : (
                        <span>PAY {selectedTournament.entryFee} & CONFIRM</span>
                      )}
                    </button>
                  </div>
                </div>
              )}

              {/* STEP 4: SUCCESS CONFIRMATION RECEIPT */}
              {step === 'success' && (
                <div className="space-y-6 text-center relative z-10 py-6">
                  <div className="w-20 h-20 bg-[#00FF66] text-black rounded-full flex items-center justify-center mx-auto shadow-[0_0_50px_rgba(0,255,102,0.5)]">
                    <CheckCircle2 className="w-12 h-12" />
                  </div>

                  <div>
                    <span className="text-xs font-mono font-bold text-[#00FF66] tracking-widest uppercase">
                      REGISTRATION CONFIRMED!
                    </span>
                    <h2 className="text-3xl font-black text-white italic uppercase mt-1">
                      YOU'RE IN THE ARENA!
                    </h2>
                    <p className="text-xs text-gray-300 mt-2 max-w-sm mx-auto">
                      Confirmation receipt sent to <span className="text-[#00FF66] font-bold">{formData.phone}</span>. Match fixture schedule will be shared on WhatsApp.
                    </p>
                  </div>

                  <div className="bg-white/5 p-4 rounded-2xl border border-white/10 text-left text-xs space-y-1 max-w-sm mx-auto">
                    <div className="flex justify-between text-gray-400">
                      <span>Event:</span>
                      <span className="text-white font-bold">{selectedTournament.title}</span>
                    </div>
                    <div className="flex justify-between text-gray-400">
                      <span>Player Name:</span>
                      <span className="text-white font-bold">{formData.playerName}</span>
                    </div>
                    <div className="flex justify-between text-gray-400">
                      <span>Amount Paid:</span>
                      <span className="text-[#00FF66] font-bold">{selectedTournament.entryFee}</span>
                    </div>
                  </div>

                  <button 
                    onClick={handleClose}
                    className="bg-[#00FF66] text-black font-extrabold text-xs uppercase px-8 py-3.5 rounded-full hover:bg-emerald-300 transition-all"
                  >
                    RETURN TO ARENA HUB
                  </button>
                </div>
              )}

            </motion.div>
          </div>
        )}
      </AnimatePresence>

    </section>
  );
}
