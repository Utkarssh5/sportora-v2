'use client';

import { Search, Zap } from 'lucide-react';

interface HeroProps {
  query: string;
  setQuery: (q: string) => void;
}

export default function Hero({ query, setQuery }: HeroProps) {
  return (
    <section className="pt-36 pb-16 px-6 text-center max-w-5xl mx-auto relative z-10">
      
      {/* Badge */}
      <div className="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#00FF66]/10 border border-[#00FF66]/30 text-xs font-mono font-bold text-[#00FF66] mb-6">
        <Zap className="w-3.5 h-3.5 fill-[#00FF66]" /> AI-POWERED TOURNAMENT ENGINE
      </div>

      {/* Main Big Contrast Headline */}
      <h1 className="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight italic uppercase leading-tight mb-4">
        <span className="block text-white">PLAY HARD. ORGANIZE EASY.</span>
        <span className="text-[#00FF66]">WELCOME TO THE ARENA.</span>
      </h1>

      {/* Subtitle */}
      <p className="text-gray-300 text-sm sm:text-base max-w-2xl mx-auto mb-10 font-medium">
        Find tournaments, book verified referees, and track real-time match scores in one smooth space.
      </p>

      {/* Search Bar */}
      <div className="max-w-2xl mx-auto bg-white/10 p-2 rounded-full border border-white/20 backdrop-blur-md flex items-center gap-2 shadow-2xl">
        <Search className="w-5 h-5 text-gray-400 ml-4 shrink-0" />
        <input
          type="text"
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          placeholder="Try searching: 'football', 'badminton', 'cricket', 'Jaipur'..."
          className="w-full bg-transparent text-white text-sm outline-none placeholder-gray-400 px-2"
        />
        <button 
          onClick={() => {
            const el = document.getElementById('tournaments');
            if (el) el.scrollIntoView({ behavior: 'smooth' });
          }}
          className="bg-[#00FF66] text-black font-extrabold px-6 py-3 rounded-full text-xs uppercase tracking-wider hover:bg-emerald-300 transition-all shrink-0"
        >
          Search
        </button>
      </div>

    </section>
  );
}
