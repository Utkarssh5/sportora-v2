              >
                <X className="h-4 w-4" />
              </button>

              {/* STEP 1 */}
              {step === 'details' && (
                <div className="relative z-10 space-y-6">
                  <div className="flex items-center gap-3">
                    <span className="text-2xl">{selectedTournament.icon}</span>

                    <span className="rounded-full border border-[#00ff66]/40 bg-[#00ff66]/10 px-3 py-1 text-xs font-black uppercase text-[#00ff66]">
                      {selectedTournament.sport} • {selectedTournament.status}
                    </span>
                  </div>

                  <div>
                    <h2 className="text-2xl font-black uppercase italic tracking-tight text-white sm:text-3xl">
                      {selectedTournament.title}
                    </h2>

                    <p className="mt-2 text-xs leading-relaxed text-white/50">
                      {selectedTournament.description}
                    </p>
                  </div>

                  <div className="grid grid-cols-1 gap-4 rounded-2xl border border-white/10 bg-white/5 p-4 text-xs sm:grid-cols-2">
                    <div>
                      <div className="font-mono text-[10px] uppercase text-white/30">
                        VENUE
                      </div>
                      <div className="font-bold text-white">
                        {selectedTournament.location}
                      </div>
                    </div>

                    <div>
                      <div className="font-mono text-[10px] uppercase text-white/30">
                        DATES
                      </div>
                      <div className="font-bold text-white">
                        {selectedTournament.date}
                      </div>
                    </div>
                  </div>

                  <div className="space-y-2">
                    <h4 className="text-xs font-mono font-bold uppercase tracking-wider text-[#00ff66]">
                      RULES & REQUIREMENTS
                    </h4>

                    <ul className="space-y-1 text-xs text-white/50">
                      {selectedTournament.rules.map((rule, idx) => (
                        <li key={idx} className="flex items-center gap-2">
