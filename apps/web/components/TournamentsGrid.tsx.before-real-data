                  </div>

                  <div className="flex items-center justify-between border-t border-white/10 pt-4">
                    <div>
                      <div className="text-[10px] uppercase text-white/30">
                        ENTRY FEE
                      </div>

                      <div className="text-2xl font-black text-[#00ff66]">
                        {selectedTournament.entryFee}
