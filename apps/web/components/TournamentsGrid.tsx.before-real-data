            <span>DISCOVER</span>
            <span className="h-px w-8 bg-white/10" />
            <span>VERIFY</span>
            <span className="h-px w-8 bg-white/10" />
            <span>COMPETE</span>
          </div>
        </div>
      </motion.div>

