              className="flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-3 text-[10px] font-black uppercase tracking-wider text-white transition-all duration-300 hover:border-[#00ff66] hover:bg-[#00ff66] hover:text-black"
