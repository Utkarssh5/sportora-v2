                    </div>

                    <button
                      onClick={() => setStep('form')}
                      className="flex items-center gap-2 rounded-full bg-[#00ff66] px-8 py-3.5 text-xs font-extrabold uppercase text-black transition-all hover:bg-emerald-300"
                    >
                      PROCEED TO REGISTER
                      <ArrowRight className="h-4 w-4" />
                    </button>
                  </div>
                </div>
              )}

              {/* STEP 2 */}
              {step === 'form' && (
                <div className="relative z-10 space-y-6">
                  <div className="flex items-center justify-between border-b border-white/10 pb-4">
                    <h3 className="flex items-center gap-2 text-xl font-black uppercase italic text-white">
                      <User className="h-5 w-5 text-[#00ff66]" />
                      REGISTRATION FORM
                    </h3>

                    <span className="text-xs font-mono text-[#00ff66]">
                      STEP 1 OF 2
                    </span>
                  </div>

                  <div className="space-y-4">
                    <div>
                      <label className="mb-1 block text-xs font-mono font-bold uppercase text-white/50">
                        Captain / Player Name *
                      </label>

                      <input
                        type="text"
                        placeholder="Enter full name"
                        value={formData.playerName}
                        onChange={(e) =>
                          setFormData({
                            ...formData,
                            playerName: e.target.value,
                          })
                        }
                        className="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white outline-none focus:border-[#00ff66]"
                      />
                    </div>

                    <div>
                      <label className="mb-1 block text-xs font-mono font-bold uppercase text-white/50">
                        Phone Number (For WhatsApp Updates) *
                      </label>

                      <input
                        type="tel"
                        placeholder="+91 98765 43210"
                        value={formData.phone}
                        onChange={(e) =>
                          setFormData({
                            ...formData,
                            phone: e.target.value,
                          })
                        }
                        className="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white outline-none focus:border-[#00ff66]"
                      />
                    </div>

                    <div>
                      <label className="mb-1 block text-xs font-mono font-bold uppercase text-white/50">
                        Team Name (Optional for Singles)
                      </label>

                      <input
                        type="text"
                        placeholder="e.g. Gurgaon Strikers"
                        value={formData.teamName}
                        onChange={(e) =>
                          setFormData({
                            ...formData,
                            teamName: e.target.value,
                          })
                        }
                        className="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white outline-none focus:border-[#00ff66]"
                      />
                    </div>
                  </div>

                  <div className="flex items-center justify-between border-t border-white/10 pt-4">
                    <button
                      onClick={() => setStep('details')}
                      className="text-xs font-bold uppercase text-white/40 hover:text-white"
                    >
                      Back
                    </button>

                    <button
                      disabled={!formData.playerName || !formData.phone}
                      onClick={() => setStep('payment')}
                      className="flex items-center gap-2 rounded-full bg-[#00ff66] px-8 py-3.5 text-xs font-extrabold uppercase text-black transition-all hover:bg-emerald-300 disabled:opacity-40"
                    >
                      CONTINUE TO PAYMENT
                      <CreditCard className="h-4 w-4" />
                    </button>
                  </div>
                </div>
              )}

              {/* STEP 3 */}
              {step === 'payment' && (
                <div className="relative z-10 space-y-6">
                  <div className="flex items-center justify-between border-b border-white/10 pb-4">
                    <h3 className="flex items-center gap-2 text-xl font-black uppercase italic text-white">
                      <CreditCard className="h-5 w-5 text-[#00ff66]" />
                      PAYMENT GATEWAY
                    </h3>

                    <span className="text-xs font-mono text-[#00ff66]">
                      STEP 2 OF 2
                    </span>
                  </div>

                  <div className="flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div>
                      <div className="font-mono text-[10px] uppercase text-white/30">
                        TOTAL AMOUNT PAYABLE
                      </div>

                      <div className="text-2xl font-black text-[#00ff66]">
                        {selectedTournament.entryFee}
                      </div>
                    </div>

                    <div className="text-right text-xs text-white/50">
                      <div className="font-bold text-white">
                        {formData.playerName}
                      </div>

                      <div>{formData.phone}</div>
                    </div>
                  </div>

                  <div className="space-y-3">
                    <label className="block text-xs font-mono font-bold uppercase text-white/50">
                      SELECT PAYMENT METHOD
                    </label>

                    <div className="grid grid-cols-2 gap-3">
                      <button
                        onClick={() =>
                          setFormData({
                            ...formData,
                            paymentMethod: 'upi',
                          })
                        }
                        className={`flex items-center gap-3 rounded-2xl border p-4 transition-all ${
                          formData.paymentMethod === 'upi'
                            ? 'border-[#00ff66] bg-[#00ff66]/10 text-white'
                            : 'border-white/10 bg-white/5 text-white/40'
                        }`}
                      >
                        <QrCode className="h-5 w-5 text-[#00ff66]" />
                        <span className="text-xs font-bold uppercase">
                          UPI / QR SCAN
                        </span>
                      </button>

                      <button
                        onClick={() =>
                          setFormData({
                            ...formData,
                            paymentMethod: 'card',
                          })
                        }
                        className={`flex items-center gap-3 rounded-2xl border p-4 transition-all ${
                          formData.paymentMethod === 'card'
                            ? 'border-[#00ff66] bg-[#00ff66]/10 text-white'
                            : 'border-white/10 bg-white/5 text-white/40'
                        }`}
                      >
                        <CreditCard className="h-5 w-5 text-[#00ff66]" />
                        <span className="text-xs font-bold uppercase">
                          CARD / NETBANKING
                        </span>
                      </button>
                    </div>
                  </div>

                  <div className="flex items-center justify-between border-t border-white/10 pt-4">
                    <button
                      onClick={() => setStep('form')}
                      className="text-xs font-bold uppercase text-white/40 hover:text-white"
                    >
                      Back
                    </button>

                    <button
                      onClick={handlePaymentSubmit}
                      disabled={isProcessing}
                      className="rounded-full bg-[#00ff66] px-8 py-3.5 text-xs font-extrabold uppercase text-black shadow-lg shadow-[#00ff66]/20 transition-all hover:bg-emerald-300"
                    >
                      {isProcessing
                        ? 'PROCESSING PAYMENT...'
                        : `PAY ${selectedTournament.entryFee} & CONFIRM`}
                    </button>
                  </div>
                </div>
              )}

              {/* STEP 4 */}
              {step === 'success' && (
                <div className="relative z-10 space-y-6 py-6 text-center">
                  <div className="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#00ff66] text-black shadow-[0_0_50px_rgba(0,255,102,0.5)]">
                    <CheckCircle2 className="h-12 w-12" />
                  </div>

                  <div>
                    <span className="text-xs font-mono font-bold uppercase tracking-widest text-[#00ff66]">
                      REGISTRATION CONFIRMED!
                    </span>

                    <h2 className="mt-1 text-3xl font-black uppercase italic text-white">
                      YOU&apos;RE IN THE ARENA!
                    </h2>

                    <p className="mx-auto mt-2 max-w-sm text-xs text-white/50">
                      Confirmation receipt sent to{' '}
                      <span className="font-bold text-[#00ff66]">
                        {formData.phone}
                      </span>
                      . Match fixture schedule will be shared on WhatsApp.
                    </p>
                  </div>

                  <div className="mx-auto max-w-sm space-y-1 rounded-2xl border border-white/10 bg-white/5 p-4 text-left text-xs">
                    <div className="flex justify-between text-white/40">
                      <span>Event:</span>
                      <span className="font-bold text-white">
                        {selectedTournament.title}
                      </span>
                    </div>

                    <div className="flex justify-between text-white/40">
                      <span>Player Name:</span>
                      <span className="font-bold text-white">
                        {formData.playerName}
                      </span>
                    </div>

                    <div className="flex justify-between text-white/40">
                      <span>Amount Paid:</span>
                      <span className="font-bold text-[#00ff66]">
                        {selectedTournament.entryFee}
                      </span>
                    </div>
                  </div>

                  <button
                    onClick={handleClose}
                    className="rounded-full bg-[#00ff66] px-8 py-3.5 text-xs font-extrabold uppercase text-black transition-all hover:bg-emerald-300"
                  >
                    RETURN TO ARENA HUB
                  </button>
                </div>
              )}
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </section>
  );
}

function TournamentCard({
  item,
  index,
  onSelect,
}: {
  item: (typeof MOCK_TOURNAMENTS)[0];
  index: number;
  onSelect: () => void;
}) {
  const direction = index % 2 === 0 ? -80 : 80;

  return (
    <motion.article
      initial={{
        opacity: 0,
        x: direction,
        y: 40,
      }}
      whileInView={{
        opacity: 1,
        x: 0,
        y: 0,
      }}
      viewport={{
        once: true,
        amount: 0.18,
      }}
      transition={{
        duration: 0.85,
        delay: index * 0.12,
        ease: [0.22, 1, 0.36, 1],
      }}
      className="group relative"
    >
      <div className="absolute -left-1 top-8 hidden text-[9px] font-black tracking-[0.3em] text-white/20 lg:block">
        EVENT / 0{index + 1}
      </div>

      <div className="grid overflow-hidden rounded-[32px] border border-white/10 bg-white/[0.025] backdrop-blur-xl transition-all duration-500 group-hover:border-[#00ff66]/30 group-hover:shadow-[0_25px_80px_rgba(0,255,102,0.08)] md:grid-cols-[1.15fr_0.85fr]">
        <div className="relative h-[300px] overflow-hidden md:h-[430px]">
          <motion.img
            src={item.imgUrl}
            alt={item.title}
            whileHover={{ scale: 1.08 }}
            transition={{ duration: 0.8 }}
            className="h-full w-full object-cover"
          />

          <div className="absolute inset-0 bg-gradient-to-r from-black/20 via-black/10 to-[#080b10]" />
          <div className="absolute inset-0 bg-gradient-to-t from-[#080b10] via-transparent to-black/30" />

          <div className="absolute left-5 top-5 flex items-center gap-2 rounded-full border border-white/15 bg-black/50 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-white backdrop-blur-xl">
            <span className="text-base">{item.icon}</span>
            <span className="text-[#00ff66]">{item.sport}</span>
          </div>

          <div className="absolute right-5 top-5 rounded-full bg-[#00ff66] px-3 py-1.5 text-[9px] font-black uppercase tracking-wider text-black shadow-[0_0_20px_rgba(0,255,102,0.25)]">
            {item.status}
          </div>

          <div className="absolute bottom-5 left-5">
            <div className="mb-2 text-[9px] font-bold tracking-[0.25em] text-white/50">
              VERIFIED EVENT
            </div>

            <div className="flex items-center gap-2 text-xs font-bold text-[#00ff66]">
              <ShieldCheck className="h-4 w-4" />
              {item.riskScore}% TRUST SCORE
            </div>
          </div>
        </div>

        <div className="flex flex-col justify-between p-7 sm:p-9">
          <div>
            <div className="mb-6 flex items-center justify-between">
              <span className="text-[9px] font-black tracking-[0.3em] text-white/25">
                SPORTS / EVENT
              </span>

              <span className="text-5xl font-black tracking-[-0.08em] text-white/[0.06]">
                0{index + 1}
              </span>
            </div>

            <h3 className="max-w-xl text-3xl font-black uppercase leading-[0.95] tracking-[-0.04em] text-white transition-colors duration-300 group-hover:text-[#00ff66] sm:text-4xl">
              {item.title}
            </h3>

            <p className="mt-5 text-sm leading-6 text-white/40">
              {item.description}
            </p>

            <div className="mt-7 space-y-3 border-y border-white/10 py-5 text-xs text-white/50">
              <div className="flex items-center gap-3">
                <MapPin className="h-4 w-4 shrink-0 text-[#00ff66]" />
                <span>{item.location}</span>
              </div>

              <div className="flex items-center gap-3">
                <Calendar className="h-4 w-4 shrink-0 text-[#00ff66]" />
